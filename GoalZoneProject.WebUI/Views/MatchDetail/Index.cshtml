@model ResultFixtureDto
@using GoalZoneProject.WebUI.Dtos.MatchEventDtos
@{
    Layout = null;
    var events = ViewBag.Events as List<ResultMatchEventDto>;
    var stats = ViewBag.Stats as List<ResultMatchStatisticDto>;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Arsenal 2–2 Liverpool — GoalZone Maç Detayı</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Barlow:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #080d18;
            --bg2: #0c1220;
            --card: #111827;
            --card2: #16202f;
            --elevated: #1c2d42;
            --green: #00e676;
            --blue: #2979ff;
            --live: #ff1744;
            --gold: #ffd600;
            --yellow: #ffc107;
            --red: #f44336;
            --t1: #eef2ff;
            --t2: #7b96c4;
            --t3: #3d5478;
            --border: #1a2640;
            --r1: 8px;
            --r2: 12px;
            --r3: 16px;
            --shadow: 0 4px 24px rgba(0,0,0,.5);
            --tr: all .22s cubic-bezier(.4,0,.2,1);
            --fd: 'Barlow Condensed',sans-serif;
            --fb: 'Barlow',sans-serif;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        html {
            scroll-behavior: smooth
        }

        body {
            font-family: var(--fb);
            background: var(--bg);
            color: var(--t1);
            min-height: 100vh;
            background-image: radial-gradient(ellipse at 15% 0%,rgba(41,121,255,.07) 0%,transparent 55%), radial-gradient(ellipse at 85% 0%,rgba(0,230,118,.04) 0%,transparent 50%)
        }

        ::-webkit-scrollbar {
            width: 5px
        }

        ::-webkit-scrollbar-track {
            background: var(--bg)
        }

        ::-webkit-scrollbar-thumb {
            background: var(--elevated);
            border-radius: 3px
        }

        a {
            text-decoration: none;
            color: inherit
        }

        img {
            display: block
        }

        /* ── NAVBAR ── */
        .nb {
            background: rgba(8,13,24,.96);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 24px rgba(0,0,0,.5)
        }

        .nb-inner {
            max-width: 1120px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 0
        }

        .brand-ico {
            width: 34px;
            height: 34px;
            background: linear-gradient(135deg,var(--green),var(--blue));
            border-radius: 7px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px
        }

        .brand-txt {
            font-family: var(--fd);
            font-size: 21px;
            font-weight: 800;
            letter-spacing: 1px
        }

            .brand-txt span {
                color: var(--green)
            }

        .nav-links {
            display: flex
        }

        .nl {
            font-family: var(--fd);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--t2);
            padding: 22px 15px;
            position: relative;
            transition: var(--tr)
        }

            .nl::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 15px;
                right: 15px;
                height: 2px;
                background: var(--green);
                transform: scaleX(0);
                transition: var(--tr)
            }

            .nl:hover, .nl.active {
                color: var(--t1)
            }

                .nl:hover::after, .nl.active::after {
                    transform: scaleX(1)
                }

        .nb-icons {
            display: flex;
            align-items: center;
            gap: 5px
        }

        .ico-btn {
            width: 36px;
            height: 36px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r1);
            color: var(--t2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            transition: var(--tr)
        }

            .ico-btn:hover {
                background: var(--elevated);
                color: var(--t1);
                border-color: var(--blue)
            }

        .tog {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r1);
            padding: 7px 9px;
            color: var(--t1);
            cursor: pointer;
            line-height: 1
        }

        .mob-menu {
            max-height: 0;
            overflow: hidden;
            transition: max-height .3s ease
        }

            .mob-menu.open {
                max-height: 320px
            }

            .mob-menu .nl {
                padding: 14px 0;
                border-bottom: 1px solid var(--border);
                display: block
            }

        /* ── WRAP ── */
        .wrap {
            max-width: 1120px;
            margin: 0 auto;
            padding: 0 20px
        }

        /* ── HERO ── */
        .hero {
            background: linear-gradient(180deg,#0b1830 0%,var(--bg) 100%);
            border-bottom: 1px solid var(--border);
            padding: 36px 0 28px;
            position: relative;
            overflow: hidden
        }

            .hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse at 20% 50%,rgba(0,230,118,.05) 0%,transparent 60%), radial-gradient(ellipse at 80% 50%,rgba(41,121,255,.05) 0%,transparent 60%);
                pointer-events: none
            }

        .hero-badges {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 26px;
            flex-wrap: wrap
        }

        .hbadge {
            font-family: var(--fd);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 4px 12px;
            border-radius: 20px
        }

        .hb-gold {
            background: rgba(255,214,0,.09);
            border: 1px solid rgba(255,214,0,.2);
            color: var(--gold)
        }

        .hb-gray {
            background: rgba(143,163,200,.08);
            color: var(--t3)
        }

        .hb-green {
            background: rgba(0,230,118,.08);
            border: 1px solid rgba(0,230,118,.18);
            color: var(--green)
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 20px;
            align-items: center
        }

        .h-team {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px
        }

        .h-logo {
            width: 86px;
            height: 86px;
            border-radius: 50%;
            background: var(--card);
            border: 2px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--fd);
            font-size: 24px;
            font-weight: 900;
            overflow: hidden
        }

            .h-logo img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                padding: 8px
            }

        .h-name {
            font-family: var(--fd);
            font-size: clamp(18px,3vw,26px);
            font-weight: 900;
            letter-spacing: .3px;
            text-align: center
        }

        .h-type {
            font-size: 10px;
            color: var(--t3);
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 600
        }

        .h-score-c {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px
        }

        .h-sc {
            font-family: var(--fd);
            font-size: clamp(54px,10vw,88px);
            font-weight: 900;
            letter-spacing: -4px;
            line-height: 1;
            background: linear-gradient(180deg,#fff 0%,#8fa3c8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text
        }

        .h-ht {
            font-family: var(--fd);
            font-size: 12px;
            color: var(--t2);
            background: var(--card);
            padding: 4px 14px;
            border-radius: 11px;
            border: 1px solid var(--border)
        }

        .h-ft {
            font-family: var(--fd);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--t3)
        }

        .info-strip {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 22px;
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid var(--border);
            flex-wrap: wrap
        }

        .istrip {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: var(--t2)
        }

            .istrip i {
                color: var(--t3);
                font-size: 13px
            }

        /* ── CONTENT ── */
        .content {
            padding: 28px 0 56px
        }

        .dc {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r3);
            padding: 22px;
            margin-bottom: 18px
        }

        .dc-title {
            font-family: var(--fd);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--t3);
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 10px
        }

            .dc-title::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border)
            }

        /* ── TIMELINE ── */
        .tl-wrap {
            position: relative
        }

        .tl-line {
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 1px;
            background: var(--border);
            transform: translateX(-50%)
        }

        .tl-ev {
            display: grid;
            grid-template-columns: 1fr 58px 1fr;
            gap: 10px;
            align-items: center;
            margin-bottom: 10px;
            animation: fadeUp .4s ease both
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(8px)
            }

            to {
                opacity: 1;
                transform: none
            }
        }

        .tl-ev:nth-child(1) {
            animation-delay: .05s
        }

        .tl-ev:nth-child(2) {
            animation-delay: .1s
        }

        .tl-ev:nth-child(3) {
            animation-delay: .15s
        }

        .tl-ev:nth-child(4) {
            animation-delay: .2s
        }

        .tl-ev:nth-child(5) {
            animation-delay: .25s
        }

        .tl-ev:nth-child(6) {
            animation-delay: .3s
        }

        .tl-ev:nth-child(7) {
            animation-delay: .35s
        }

        .tl-ev:nth-child(8) {
            animation-delay: .4s
        }

        .tl-ev:nth-child(9) {
            animation-delay: .45s
        }

        .tl-ev:nth-child(10) {
            animation-delay: .5s
        }

        .tl-ev:nth-child(11) {
            animation-delay: .55s
        }

        .tl-home {
            display: flex;
            justify-content: flex-end
        }

        .tl-away {
            display: flex;
            justify-content: flex-start
        }

        .tl-min-c {
            display: flex;
            align-items: center;
            justify-content: center
        }

        .min-b {
            background: var(--elevated);
            border: 1px solid var(--border);
            border-radius: 11px;
            padding: 3px 8px;
            font-family: var(--fd);
            font-size: 11px;
            font-weight: 700;
            color: var(--t2);
            white-space: nowrap;
            position: relative;
            z-index: 1
        }

        .chip {
            display: flex;
            align-items: center;
            gap: 7px;
            background: var(--elevated);
            border: 1px solid var(--border);
            border-radius: var(--r1);
            padding: 8px 11px;
            max-width: 210px
        }

            .chip.home {
                flex-direction: row-reverse;
                text-align: right
            }

            .chip.goal-ev {
                border-color: rgba(0,230,118,.25);
                background: rgba(0,230,118,.06)
            }

            .chip.yel-ev {
                border-color: rgba(255,193,7,.25);
                background: rgba(255,193,7,.06)
            }

            .chip.red-ev {
                border-color: rgba(244,67,54,.25);
                background: rgba(244,67,54,.06)
            }

            .chip.sub-ev {
                border-color: rgba(41,121,255,.2);
                background: rgba(41,121,255,.05)
            }

        .ev-ico {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            flex-shrink: 0
        }

        .ei-goal {
            background: rgba(0,230,118,.15);
            color: var(--green)
        }

        .ei-yel {
            background: rgba(255,193,7,.15);
            color: var(--yellow)
        }

        .ei-red {
            background: rgba(244,67,54,.15);
            color: var(--red)
        }

        .ei-sub {
            background: rgba(41,121,255,.12);
            color: var(--blue)
        }

        .ev-pl {
            font-family: var(--fd);
            font-size: 14px;
            font-weight: 700;
            color: var(--t1)
        }

        .ev-dt {
            font-size: 10px;
            color: var(--t3)
        }

        /* ── GOALS / CARDS ── */
        .split2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px
        }

        .box2 {
            padding: 14px;
            background: var(--bg2);
            border-radius: var(--r2);
            border: 1px solid var(--border)
        }

        .box2-title {
            font-family: var(--fd);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--t3);
            margin-bottom: 10px
        }

        .gl {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 6px 0;
            border-bottom: 1px solid rgba(255,255,255,.04)
        }

            .gl:last-child {
                border-bottom: none
            }

        .gl-ico {
            width: 20px;
            height: 20px;
            background: rgba(0,230,118,.12);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: var(--green);
            flex-shrink: 0
        }

        .gl-pl {
            font-family: var(--fd);
            font-size: 14px;
            font-weight: 700;
            flex: 1
        }

        .gl-min {
            font-family: var(--fd);
            font-size: 11px;
            font-weight: 700;
            color: var(--t3);
            background: var(--elevated);
            padding: 2px 7px;
            border-radius: 7px
        }

        .ycard {
            width: 12px;
            height: 16px;
            background: var(--yellow);
            border-radius: 2px;
            flex-shrink: 0;
            box-shadow: 0 2px 5px rgba(255,193,7,.3)
        }

        .rcard {
            width: 12px;
            height: 16px;
            background: var(--red);
            border-radius: 2px;
            flex-shrink: 0;
            box-shadow: 0 2px 5px rgba(244,67,54,.3)
        }

        /* ── SUBSTITUTIONS ── */
        .sub-r {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 9px 0;
            border-bottom: 1px solid rgba(255,255,255,.04)
        }

            .sub-r:last-child {
                border-bottom: none
            }

        .sub-min {
            font-family: var(--fd);
            font-size: 12px;
            font-weight: 700;
            color: var(--t3);
            background: var(--elevated);
            padding: 3px 9px;
            border-radius: 9px;
            width: 46px;
            text-align: center;
            flex-shrink: 0
        }

        .sub-in {
            font-family: var(--fd);
            font-size: 13px;
            font-weight: 700;
            color: var(--green)
        }

        .sub-out {
            font-family: var(--fd);
            font-size: 13px;
            font-weight: 700;
            color: var(--live)
        }

        .sub-arr {
            color: var(--t3);
            font-size: 15px
        }

        .sub-lbl {
            font-family: var(--fd);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--t3);
            margin: 14px 0 6px;
            padding-top: 10px;
            border-top: 1px solid var(--border)
        }

            .sub-lbl:first-child {
                margin-top: 0;
                padding-top: 0;
                border-top: none
            }

        /* ── STATS ── */
        .stat-r {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 10px;
            align-items: center;
            margin-bottom: 12px
        }

        .sv-h {
            font-family: var(--fd);
            font-size: 17px;
            font-weight: 800;
            text-align: right
        }

        .sv-a {
            font-family: var(--fd);
            font-size: 17px;
            font-weight: 800;
            text-align: left
        }

        .sl {
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--t3);
            text-align: center;
            white-space: nowrap
        }

        .bar-r {
            display: grid;
            grid-template-columns: 1fr 20px 1fr;
            gap: 7px;
            align-items: center;
            margin-bottom: 12px
        }

        .bh {
            height: 3px;
            background: var(--elevated);
            border-radius: 2px;
            overflow: hidden;
            display: flex;
            justify-content: flex-end
        }

            .bh .f {
                height: 100%;
                background: linear-gradient(90deg,var(--blue),#6aabff);
                border-radius: 2px;
                transition: width 1.1s ease
            }

        .ba {
            height: 3px;
            background: var(--elevated);
            border-radius: 2px;
            overflow: hidden
        }

            .ba .f {
                height: 100%;
                background: linear-gradient(90deg,#ff6b6b,var(--live));
                border-radius: 2px;
                transition: width 1.1s ease
            }

        /* ── MATCH INFO BOX ── */
        .mi-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 9px 0;
            border-bottom: 1px solid var(--border);
            font-size: 13px
        }

            .mi-row:last-child {
                border-bottom: none
            }

        .mi-key {
            color: var(--t3)
        }

        .mi-val {
            font-family: var(--fd);
            font-size: 14px;
            font-weight: 700;
            text-align: right
        }

        /* ── SCORE PILLS ── */
        .sc-pills {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 8px;
            margin-bottom: 4px
        }

        .sc-pill {
            background: var(--bg2);
            border-radius: var(--r2);
            padding: 11px;
            text-align: center;
            border: 1px solid var(--border)
        }

        .sp-lbl {
            font-family: var(--fd);
            font-size: 10px;
            color: var(--t3);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 3px
        }

        .sp-val {
            font-family: var(--fd);
            font-size: 22px;
            font-weight: 900
        }

        /* ── BACK BTN ── */
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r2);
            color: var(--t2);
            padding: 10px 18px;
            font-family: var(--fd);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: var(--tr);
            margin-bottom: 22px
        }

            .back-btn:hover {
                background: var(--elevated);
                border-color: var(--blue);
                color: var(--t1)
            }

        /* ── FOOTER ── */
        .ft {
            background: var(--bg2);
            border-top: 1px solid var(--border);
            padding: 44px 0 22px;
            margin-top: 36px
        }

        .ft-brand {
            font-family: var(--fd);
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 8px
        }

            .ft-brand span {
                color: var(--green)
            }

        .ft-desc {
            font-size: 12px;
            color: var(--t3);
            line-height: 1.7;
            max-width: 240px
        }

        .ft-h {
            font-family: var(--fd);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--t2);
            margin-bottom: 14px
        }

        .ft-ul {
            list-style: none;
            padding: 0
        }

            .ft-ul li {
                margin-bottom: 7px
            }

            .ft-ul a {
                color: var(--t3);
                font-size: 12px;
                transition: var(--tr)
            }

                .ft-ul a:hover {
                    color: var(--t1)
                }

        .si-row {
            display: flex;
            gap: 7px;
            margin-top: 14px
        }

        .si {
            width: 34px;
            height: 34px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--r1);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--t3);
            transition: var(--tr);
            font-size: 13px
        }

            .si:hover {
                background: var(--elevated);
                color: var(--green);
                border-color: var(--green)
            }

        .ft-bot {
            border-top: 1px solid var(--border);
            padding-top: 18px;
            margin-top: 32px;
            font-size: 11px;
            color: var(--t3);
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 6px
        }

        /* ── RESPONSIVE ── */
        @@media(max - width:768px) {
            .hero-grid {
                gap: 10px
            }

            .h-logo {
                width: 60px;
                height: 60px
            }

            .h-name {
                font-size: 14px
            }

            .h-sc {
                font-size: 52px;
                letter-spacing: -2px
            }

            .tl-ev {
                grid-template-columns: 1fr 46px 1fr;
                gap: 5px
            }

            .chip {
                padding: 6px 8px;
                max-width: 140px
            }

            .ev-pl {
                font-size: 12px
            }

            .ev-dt {
                display: none
            }

            .ev-ico {
                width: 22px;
                height: 22px;
                font-size: 11px
            }

            .split2 {
                grid-template-columns: 1fr
            }

            .info-strip {
                gap: 12px
            }

            .istrip {
                font-size: 11px
            }

            .sc-pills {
                grid-template-columns: repeat(3,1fr)
            }
        }

        @@media(max - width:480px) {
            .h-sc {
                font-size: 42px
            }

            .h-logo {
                width: 50px;
                height: 50px
            }

            .h-name {
                font-size: 12px
            }

            .info-strip {
                gap: 8px
            }
        }

        /* Ana Kart Yapısı */
        .stats-card {
            background: #1a1d23;
            padding: 20px;
            border-radius: 12px;
            color: #fff;
        }

        /* İstatistik Satırı */
        .match-stat {
            margin-bottom: 15px;
        }

        .stat-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .stat-label {
            color: #94a3b8;
            font-size: 0.9rem;
        }

        .winner {
            color: #3b82f6; /* Kazanan tarafı vurgulamak için (isteğe bağlı) */
        }

        /* Karşılaştırma Barı */
        .compare-bar {
            display: flex;
            width: 100%;
            height: 8px;
            gap: 6px; /* İki bar arasındaki boşluk */
        }

        .side {
            flex: 1; /* BURASI KRİTİK: Her iki tarafın tam %50 olmasını sağlar */
            display: flex;
            background: rgba(255, 255, 255, 0.05); /* Barın boş kısmının rengi */
            border-radius: 4px;
            overflow: hidden;
        }

        .home-side {
            justify-content: flex-end; /* Ev sahibi barı SAĞDAN sola doğru büyür */
        }

        .away-side {
            justify-content: flex-start; /* Deplasman barı SOLDAN sağa doğru büyür */
        }

        .fill {
            height: 100%;
            transition: width 0.5s ease-out;
            border-radius: 4px;
        }

        .home-fill {
            background: linear-gradient(to left, #3b82f6, #60a5fa);
        }

        .away-fill {
            background: linear-gradient(to right, #22c55e, #4ade80);
        }

        /* Disiplin ve Legend */
        .card-boxes {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        .discipline {
            flex: 1;
            padding: 10px;
            text-align: center;
            border-radius: 8px;
            font-size: 0.85rem;
            display: flex;
            justify-content: space-between;
        }

        .yellow {
            background: rgba(234, 179, 8, 0.1);
            color: #eab308;
        }

        .red {
            background: rgba(239, 68, 68, 0.1);
            color: #ef4444;
        }

        .legend {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            font-size: 0.8rem;
            color: #94a3b8;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="nb">
        <div class="nb-inner">
            <a href="/Main/Index/" class="brand">
                <div class="brand-ico">⚽</div>
                <span class="brand-txt">Goal<span>Zone</span></span>
            </a>
            <div class="nav-links d-none d-lg-flex">
                <a href="/Main/Index/" class="nl">Ana Sayfa</a>
                <a href="/Fixture/Index/" class="nl">Fikstür</a>
                <a href="/Team/TeamList/" class="nl">Puan Durumu</a>
            </div>
            <div class="nb-icons">
                <a href="#" class="ico-btn d-none d-sm-flex"><i class="bi bi-search"></i></a>
                <a href="#" class="ico-btn d-none d-sm-flex"><i class="bi bi-bell"></i></a>
                <a href="/Admin/Index" class="ico-btn"><i class="bi bi-person"></i></a>
                <button class="tog d-lg-none" id="tog"><i class="bi bi-list"></i></button>
            </div>
        </div>
        <div class="mob-menu" id="mobMenu">
            <div class="wrap">
                <a href="/Main/Index/" class="nl d-block">Ana Sayfa</a>
                <a href="/Fixture/Index/" class="nl d-block">Fikstür</a>
                <a href="/Team/TeamList/" class="nl d-block">Puan Durumu</a>
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <section class="hero">
        <div class="wrap">
            <div class="hero-badges">
                <span class="hbadge hb-gold"><i class="bi bi-trophy-fill me-1"></i>Premier League · Hafta @Model.WeekNumber</span>
                <span class="hbadge hb-gray"><i class="bi bi-check2-circle me-1"></i>@Model.Status</span>
                <span class="hbadge hb-green"><i class="bi bi-people-fill me-1"></i>60,260 Seyirci</span>
            </div>
            <div class="hero-grid">
                <div class="h-team">
                    <div class="h-logo" style="border-color:rgba(239,1,7,.5);box-shadow:0 0 28px rgba(239,1,7,.1)">
                        <img src="@Model.HomeTeam.LogoUrl" alt="@Model.HomeTeam.TeamName" onerror="this.parentNode.textContent='?'" />
                    </div>
                    <div class="h-name">@Model.HomeTeam.TeamName</div>
                    <div class="h-type">Ev Sahibi</div>
                </div>
                <div class="h-score-c">
                    @if (Model.Status == "Henüz Oynanmadi")
                    {
                        <div class="h-sc">-</div>
                        <div class="h-ht"><i class="bi bi-hourglass me-1"></i>Oynanmadı</div>
                    }
                    else
                    {
                        <div class="h-sc">@Model.HomeTeamScore-@Model.AwayTeamScore</div>
                        <div class="h-ht"><i class="bi bi-hourglass-split me-1"></i>İY: @Model.HomeTeamHalfScore–@Model.AwayTeamHalfScore</div>
                    }
                    <div class="h-ft">@Model.Status</div>
                </div>
                <div class="h-team">
                    <div class="h-logo" style="border-color:rgba(200,16,46,.5);box-shadow:0 0 28px rgba(200,16,46,.1)">
                        <img src="@Model.AwayTeam.LogoUrl" alt="@Model.AwayTeam.TeamName" onerror="this.parentNode.textContent='LIV'" />
                    </div>
                    <div class="h-name">@Model.AwayTeam.TeamName</div>
                    <div class="h-type">Deplasman</div>
                </div>
            </div>
            <div class="info-strip">
                <div class="istrip"><i class="bi bi-geo-alt-fill"></i><span>@Model.Stadium</span></div>
                <div class="istrip"><i class="bi bi-calendar3"></i><span>@Model.MatchDate.ToString("dd MMMM yyyy")</span></div>
                <div class="istrip"><i class="bi bi-clock"></i><span>@Model.MatchDate.ToString("HH:mm")</span></div>
                <div class="istrip"><i class="bi bi-person-badge"></i><span>Michael Oliver</span></div>
            </div>
        </div>
    </section>

    <!-- CONTENT -->
    <div class="content">
        <div class="wrap">
            <a href="index.html" class="back-btn"><i class="bi bi-arrow-left"></i> Maç Listesine Dön</a>

            <div class="row g-4">

                <!-- LEFT: Timeline, Goals, Cards, Subs -->
                <div class="col-lg-7">

                @if (Model.Status == "Henüz Oynanmadi")
                {
                    <div class="dc" style="text-align:center;padding:40px 20px;color:var(--t3)">
                        <i class="bi bi-hourglass" style="font-size:36px;display:block;margin-bottom:12px"></i>
                        <div style="font-family:var(--fd);font-size:16px;font-weight:700;letter-spacing:1px">Maç Henüz Oynanmadı</div>
                        <div style="font-size:13px;margin-top:6px">Maç olayları ve istatistikler maç başladıktan sonra görüntülenecek.</div>
                    </div>
                }
                else
                {

                    <!-- TIMELINE -->
                    <div class="dc">
                        <div class="dc-title"><i class="bi bi-activity me-2" style="color:var(--green)"></i>Maç Olayları</div>
                        <div class="tl-wrap">
                            <div class="tl-line"></div>

                            @foreach (var x in events)
                            {
                                string chipClass = x.EventType == "Gol" ? "goal-ev" :
                                x.EventType == "SariKart" ? "yel-ev" :
                                x.EventType == "KirmiziKart" ? "red-ev" : "sub-ev";

                                string iconClass = x.EventType == "Gol" ? "ei-goal" :
                                x.EventType == "SariKart" ? "ei-yel" :
                                x.EventType == "KirmiziKart" ? "ei-red" : "ei-sub";

                                string iconHtml = x.EventType == "Gol" ? "<i class='bi bi-circle-fill' style='font-size:9px'></i>" :
                                x.EventType == "OyuncuDegisikligi" ? "<i class='bi bi-arrow-left-right'></i>" :
                                "<i class='bi bi-square-fill' style='font-size:10px'></i>";
                                if (x.TeamSide == "Ev Sahibi")
                                {
                                    <div class="tl-ev">
                                        <div class="tl-home">
                                            <div class="chip home @chipClass">
                                                <div class="ev-ico @iconClass">@Html.Raw(iconHtml)</div>
                                                <div><div class="ev-pl">@x.PlayerName</div><div class="ev-dt">@x.EventType</div></div>
                                            </div>
                                        </div>
                                        <div class="tl-min-c"><div class="min-b">@x.Minute'</div></div>
                                        <div class="tl-away"></div>
                                    </div>
                                }
                                else
                                {
                                    <div class="tl-ev">
                                        <div class="tl-home"></div>
                                        <div class="tl-min-c"><div class="min-b">@x.Minute'</div></div>
                                        <div class="tl-away">
                                            <div class="chip away @chipClass">
                                                <div class="ev-ico @iconClass">@Html.Raw(iconHtml)</div>
                                                <div><div class="ev-pl">@x.PlayerName</div><div class="ev-dt">@x.EventType</div></div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }

                        </div>
                    </div>

                    <!-- GOALS -->
                    <div class="dc">
                        <div class="dc-title"><i class="bi bi-circle-fill me-2" style="color:var(--green);font-size:9px"></i>Goller</div>
                        <div class="split2">
                            <div class="box2">
                                <div class="box2-title">⚽ @Model.HomeTeam.TeamName</div>
                                @foreach (var x in events.Where(x => x.EventType == "Gol" && x.TeamSide == "Ev Sahibi"))
                                {
                                    <div class="gl">
                                        <div class="gl-ico">⚽</div>
                                        <div class="gl-pl">@x.PlayerName</div>
                                        <div class="gl-min">@x.Minute'</div>
                                    </div>
                                }
                            </div>
                            <div class="box2">
                                <div class="box2-title">⚽ @Model.AwayTeam.TeamName</div>
                                @foreach (var x in events.Where(x => x.EventType == "Gol" && x.TeamSide == "Deplasman"))
                                {
                                    <div class="gl">
                                        <div class="gl-ico">⚽</div>
                                        <div class="gl-pl">@x.PlayerName</div>
                                        <div class="gl-min">@x.Minute'</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- CARDS -->
                    <div class="dc">
                        <div class="dc-title"><i class="bi bi-square-fill me-2" style="color:var(--yellow);font-size:10px"></i>Kartlar</div>
                        <div class="split2">
                            <div class="box2">
                                <div class="box2-title">@Model.HomeTeam.TeamName</div>
                                @foreach (var e in events.Where(x => (x.EventType == "SariKart" || x.EventType == "KirmiziKart") && x.TeamSide == "Ev Sahibi"))
                                {
                                    <div class="gl">
                                        @if (e.EventType == "SariKart")
                                        {
                                            <div class="ycard"></div>
                                        }
                                        else
                                        {
                                            <div class="rcard"></div>
                                        }
                                        <div class="gl-pl">@e.PlayerName</div>
                                        <div class="gl-min">@e.Minute'</div>
                                    </div>
                                }
                            </div>
                            <div class="box2">
                                <div class="box2-title">@Model.AwayTeam.TeamName</div>
                                @foreach (var e in events.Where(e => (e.EventType == "SariKart" || e.EventType == "KirmiziKart") && e.TeamSide == "Deplasman"))
                                {
                                    <div class="gl">
                                        @if (e.EventType == "SariKart")
                                        {
                                            <div class="ycard"></div>
                                        }
                                        else
                                        {
                                            <div class="rcard"></div>
                                        }
                                        <div class="gl-pl">@e.PlayerName</div>
                                        <div class="gl-min">@e.Minute'</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- SUBSTITUTIONS -->
                    <div class="dc">
                        <div class="dc-title"><i class="bi bi-arrow-left-right me-2" style="color:var(--blue)"></i>Oyuncu Değişiklikleri</div>
                        <div class="sub-lbl">@Model.HomeTeam.TeamName</div>
                        @foreach (var e in events.Where(e => e.EventType == "OyuncuDegisikligi" && e.TeamSide == "Ev Sahibi"))
                        {
                            <div class="sub-r">
                                <div class="sub-min">@e.Minute'</div>
                                <div class="sub-in">@e.PlayerName</div>
                            </div>
                        }

                        <div class="sub-lbl">@Model.AwayTeam.TeamName</div>
                        @foreach (var e in events.Where(e => e.EventType == "OyuncuDegisikligi" && e.TeamSide == "Deplasman"))
                        {
                            <div class="sub-r">
                                <div class="sub-min">@e.Minute'</div>
                                <div class="sub-in">@e.PlayerName</div>
                            </div>
                        }
                    </div>

                } <!-- end else (maç oynanmış) -->

                </div>

                <!-- RIGHT: Summary, Stats, Match Info -->
                <div class="col-lg-5">

                    <!-- SCORE SUMMARY -->
                    <div class="dc">
                        <div class="dc-title"><i class="bi bi-bar-chart-fill me-2" style="color:var(--blue)"></i>Maç Özeti</div>
                        <div class="sc-pills">
                            <div class="sc-pill">
                                <div class="sp-lbl">İlk Yarı</div>
                                @if (Model.Status == "Henüz Oynanmadi")
                                {
                                    <div class="sp-val">-</div>
                                }
                                else
                                {
                                    <div class="sp-val">@Model.HomeTeamHalfScore–@Model.AwayTeamHalfScore</div>
                                }
                            </div>
                            <div class="sc-pill">
                                <div class="sp-lbl">Sonuç</div>
                                @if (Model.Status == "Henüz Oynanmadi")
                                {
                                    <div class="sp-val" style="color:var(--t3)">-</div>
                                }
                                else
                                {
                                    <div class="sp-val" style="color:var(--green)">@Model.HomeTeamScore–@Model.AwayTeamScore</div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- STATISTICS -->
                    <div class="dc">
                        <div class="dc-title"><i class="bi bi-graph-up me-2" style="color:var(--green)"></i>İstatistikler</div>

                        @if (Model.Status == "Henüz Oynanmadi")
                        {
                            <div style="text-align:center;padding:28px 0;color:var(--t3);font-size:13px">
                                <i class="bi bi-bar-chart" style="font-size:28px;display:block;margin-bottom:10px"></i>
                                İstatistikler maç sonrası görüntülenecek.
                            </div>
                        }
                        else
                        {
                        @foreach (var x in stats.Where(x => x.FixtureId == Model.FixtureId))
                        {
                            // C# Mantığı: Yüzde hesaplama ve minimum görünürlük kontrolü
                            Func<double, double, (double, double)> calculateBar = (home, away) =>
                            {
                                var total = home + away;
                                if (total <= 0) return (0, 0);

                                var h = (home / total) * 100;
                                var a = (away / total) * 100;

                                // Çok küçük değerlerin barda görünmesi için minimum %8 sınırı
                                if (home > 0 && h < 8) h = 8;
                                if (away > 0 && a < 8) a = 8;

                                return (h, a);
                            };

                            <div class="stats-card">
                                <h3 class="stats-title">Maç İstatistikleri</h3>

                                @{
                                    // İstatistik listesi (Kod tekrarını önlemek için)
                                    var items = new[] {
                                                        (Label: "Topa Sahip Olma", Home: (double)x.HomePossession, Away: (double)x.AwayPossession, IsPercent: true),
                                                        (Label: "Şut", Home: (double)x.HomeShots, Away: (double)x.AwayShots, IsPercent: false),
                                                        (Label: "İsabetli Şut", Home: (double)x.HomeShotsOnTarget, Away: (double)x.AwayShotsOnTarget, IsPercent: false),
                                                        (Label: "Pas", Home: (double)x.HomePasses, Away: (double)x.AwayPasses, IsPercent: false),
                                                        (Label: "Pas İsabeti", Home: (double)x.HomePassAccuracy, Away: (double)x.AwayPassAccuracy, IsPercent: true),
                                                        (Label: "Korner", Home: (double)x.HomeCorners, Away: (double)x.AwayCorners, IsPercent: false),
                                                        (Label: "Faul", Home: (double)x.HomeFouls, Away: (double)x.AwayFouls, IsPercent: false),
                                                        (Label: "Ofsayt", Home: (double)x.HomeOffsides, Away: (double)x.AwayOffsides, IsPercent: false)
                                                        };
                                }

                                @foreach (var item in items)
                                {
                                    var bar = calculateBar(item.Home, item.Away);

                                    <div class="match-stat">
                                        <div class="stat-head">
                                            <span class="home-val @(item.Home > item.Away ? "winner" : "")">
                                                @item.Home@(item.IsPercent ? "%" : "")
                                            </span>
                                            <span class="stat-label">@item.Label</span>
                                            <span class="away-val @(item.Away > item.Home ? "winner" : "")">
                                                @item.Away@(item.IsPercent ? "%" : "")
                                            </span>
                                        </div>

                                        <div class="compare-bar">
                                            <div class="side home-side">
                                                <div class="fill home-fill" style="width: @(bar.Item1.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                            </div>
                                            <div class="side away-side">
                                                <div class="fill away-fill" style="width: @(bar.Item2.ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="card-boxes">
                                    <div class="discipline yellow">
                                        <span>@x.HomeYellowCards</span> Sarı Kart <span>@x.AwayYellowCards</span>
                                    </div>
                                    <div class="discipline red">
                                        <span>@x.HomeRedCards</span> Kırmızı Kart <span>@x.AwayRedCards</span>
                                    </div>
                                </div>

                                <div class="legend">
                                    <div><span class="dot home-dot"></span> @Model.HomeTeam.TeamName</div>
                                    <div>@Model.AwayTeam.TeamName <span class="dot away-dot"></span></div>
                                </div>
                            </div>
                        }
                        } <!-- end else (istatistik) -->
                    </div>

                    <!-- MATCH INFO -->
                    <div class="dc">
                        <div class="dc-title"><i class="bi bi-info-circle me-2" style="color:var(--t3)"></i>Maç Bilgileri</div>
                        <div class="mi-row"><span class="mi-key">Lig</span><span class="mi-val" style="color:var(--gold)">Premier League</span></div>
                        <div class="mi-row"><span class="mi-key">Sezon</span><span class="mi-val">2024 / 2025</span></div>
                        <div class="mi-row"><span class="mi-key">Hafta</span><span class="mi-val">Hafta 33</span></div>
                        <div class="mi-row"><span class="mi-key">Stadyum</span><span class="mi-val">Emirates Stadium</span></div>
                        <div class="mi-row"><span class="mi-key">Şehir</span><span class="mi-val">Londra, İngiltere</span></div>
                        <div class="mi-row"><span class="mi-key">Seyirci</span><span class="mi-val">60,260</span></div>
                        <div class="mi-row"><span class="mi-key">Hakem</span><span class="mi-val">Michael Oliver</span></div>
                        <div class="mi-row"><span class="mi-key">Tarih</span><span class="mi-val">12 Nisan 2025</span></div>
                        <div class="mi-row"><span class="mi-key">Saat</span><span class="mi-val">16:30</span></div>
                    </div>

                </div>
            </div>

            <div class="mt-2">
                <a href="index.html" class="back-btn"><i class="bi bi-arrow-left"></i> Tüm Maçlara Dön</a>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="ft">
        <div class="wrap">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="ft-brand">Goal<span>Zone</span></div>
                    <p class="ft-desc">Premier futbol liglerinin canlı skorları, maç analizleri ve istatistikleri için tek adres.</p>
                    <div class="si-row">
                        <a href="#" class="si"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="si"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="si"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="si"><i class="bi bi-telegram"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="ft-h">Ligler</div>
                    <ul class="ft-ul">
                        <li><a href="#">Premier League</a></li>
                        <li><a href="#">La Liga</a></li>
                        <li><a href="#">Bundesliga</a></li>
                        <li><a href="#">Serie A</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="ft-h">Hızlı Erişim</div>
                    <ul class="ft-ul">
                        <li><a href="#">Canlı Skorlar</a></li>
                        <li><a href="#">Fikstür</a></li>
                        <li><a href="#">Puan Durumu</a></li>
                        <li><a href="#">Gol Krallığı</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="ft-h">Takımlar</div>
                    <ul class="ft-ul">
                        <li><a href="#">Arsenal</a></li>
                        <li><a href="#">Liverpool</a></li>
                        <li><a href="#">Man City</a></li>
                        <li><a href="#">Chelsea</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="ft-h">Destek</div>
                    <ul class="ft-ul">
